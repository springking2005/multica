# Database
POSTGRES_DB=bodiagent
POSTGRES_USER=bodiagent
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_PORT_HOST=5432

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_PORT_HOST=6379

# Django
DJANGO_SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=bodiagentteam.com,*.bodiagentteam.com
CORS_ALLOWED_ORIGINS=https://bodiagentteam.com
CSRF_TRUSTED_ORIGINS=https://bodiagentteam.com
WEB_PORT_HOST=8000
STATIC_ROOT=/app/staticfiles
MEDIA_ROOT=/app/data/uploads
DJANGO_MIGRATE_ON_START=1
DJANGO_COLLECTSTATIC_ON_START=1
# Optional first-run admin bootstrap. Leave blank in production unless you want
# the container entrypoint to create/update this superuser after migrations.
BODIAGENT_BOOTSTRAP_ADMIN_EMAIL=
BODIAGENT_BOOTSTRAP_ADMIN_PASSWORD=
BODIAGENT_BOOTSTRAP_ADMIN_NAME=admin
BODIAGENT_BOOTSTRAP_ADMIN_UPDATE_PASSWORD=1
SECURE_SSL_REDIRECT=true
# For temporary HTTP direct deployments (for example http://host:8000), set
# SECURE_SSL_REDIRECT=false. SESSION/CSRF cookie security follows this setting
# by default unless SESSION_COOKIE_SECURE/CSRF_COOKIE_SECURE are explicitly set.
# Keep SECURE_SSL_REDIRECT=true behind HTTPS.
SECURE_HSTS_SECONDS=31536000
# Serve static assets from ASGI when no reverse proxy maps /static/.
BODIAGENT_SERVE_STATIC=true
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=false
# ASGI deployment default: close DB connections at request end to avoid
# idle PostgreSQL sessions exhausting max_connections. Raise only when you
# have an external pooler or have sized PostgreSQL for persistent sessions.
DB_CONN_MAX_AGE=0
DB_SSLMODE=prefer
# Gunicorn ASGI worker count. Keep small for single-server/self-hosted Postgres;
# increase only after checking PostgreSQL max_connections headroom.
WEB_CONCURRENCY=2

# Email (Resend / SendCloud / SMTP)
FROM_EMAIL=noreply@bodiagentteam.com
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=10
SMTP_USER=
SMTP_PASSWORD=

# Storage (S3 / OSS / COS)
DJANGO_STORAGE_BACKEND=django.core.files.storage.FileSystemStorage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=

# Optional: Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Daemon container profile; requires a token generated from the app.
BODIAGENT_SERVER_URL=http://web:8000
BODIAGENT_TOKEN=
BODIAGENT_WORKSPACE_ID=
